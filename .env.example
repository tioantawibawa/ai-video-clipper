CLIPPER_DATA_DIR=./data
CLIPPER_LLM_PROVIDER=openrouter
# Automatically routes to an available free model supporting the request.
CLIPPER_LLM_MODEL=openrouter/free
CLIPPER_OPENROUTER_API_KEY=
# Ordered fallback: free OpenRouter -> direct Gemini -> paid OpenRouter.
CLIPPER_LLM_FALLBACK_ENABLED=true
CLIPPER_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
CLIPPER_OPENROUTER_PAID_MODEL=openai/gpt-4o-mini
CLIPPER_OPENAI_API_KEY=
CLIPPER_ANTHROPIC_API_KEY=
CLIPPER_GEMINI_API_KEY=
CLIPPER_TRANSCRIPTION=local
CLIPPER_WHISPER_MODEL=small.en
CLIPPER_DEVICE=auto
CLIPPER_CPU_THREADS=4
CLIPPER_MIN_DURATION=30
CLIPPER_MAX_DURATION=60
CLIPPER_MAX_CLIPS=3
CLIPPER_WIDTH=1080
CLIPPER_HEIGHT=1920
CLIPPER_FONT=DejaVu Sans
CLIPPER_FONT_SIZE=68
CLIPPER_HIGHLIGHT=FFFF00
CLIPPER_REVIEW=true
CLIPPER_ACCOUNTS_FILE=accounts.json
CLIPPER_SOURCES_FILE=sources.json
CLIPPER_POLL_SECONDS=900
# Proxy credentials belong in env, referenced from account/source JSON.
CHANNEL_PROXY=
YOUTUBE_ACCESS_TOKEN=
# Required for unattended YouTube publishing (offline OAuth consent).
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional completed-clip inbox; manifests reference MP4 files inside this directory.
CLIPPER_OUTBOX_DIR=
CLIPPER_OUTBOX_ACCOUNT=
# Set false on a publication-only VPS when editing runs on the laptop.
CLIPPER_MANAGER_RENDER=true
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
