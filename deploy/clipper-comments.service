[Unit]
Description=AI Clipper comment replies
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-video-clipper
Environment=CLIPPER_DATA_DIR=/home/ubuntu/ai-video-clipper/data/vps
Environment=CLIPPER_ACCOUNTS_FILE=/home/ubuntu/ai-video-clipper/data/vps/accounts.json
Environment=CLIPPER_SOURCES_FILE=/home/ubuntu/ai-video-clipper/data/vps/sources.json
ExecStart=/home/ubuntu/ai-video-clipper/.venv/bin/python -m clipper manager comments --config /home/ubuntu/ai-video-clipper/data/vps/manager.json
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=500M

